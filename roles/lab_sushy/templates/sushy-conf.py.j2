# sushy-emulator config. Names must start with SUSHY_EMULATOR_.

SUSHY_EMULATOR_LISTEN_IP = "0.0.0.0"
SUSHY_EMULATOR_LISTEN_PORT = {{ lab_sushy_port }}

SUSHY_EMULATOR_SSL_CERT = None
SUSHY_EMULATOR_SSL_KEY = None

SUSHY_EMULATOR_AUTH_FILE = "/root/sushy/auth.htpasswd"
SUSHY_EMULATOR_LIBVIRT_URI = "{{ lab_libvirt_uri }}"
SUSHY_EMULATOR_FEATURE_SET = "full"
SUSHY_EMULATOR_STORAGE_POOL = "default"

# Only the sandbox BMC guests. Values are libvirt domain UUIDs.
SUSHY_EMULATOR_ALLOWED_INSTANCES = [
{% for uuid in lab_bmc_uuids | default([]) %}
    "{{ uuid }}",
{% endfor %}
]

# A second CD-typed Virtual Media slot is not usable with sushy-tools' libvirt
# driver (BOOT_DEVICE_MAP is hardcoded to Cd/Floppy/Hdd/Pxe). Do not add one.
