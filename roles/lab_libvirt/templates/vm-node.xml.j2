<domain type="kvm">
  <name>{{ node.name }}</name>
{% if lab_node_info.rc == 0 %}
  <uuid>{{ lab_node_existing_uuid.stdout | trim }}</uuid>
{% endif %}
  <memory unit="MiB">{{ lab_node_memory_mib }}</memory>
  <vcpu placement="static">{{ lab_node_vcpus }}</vcpu>
  <os>
    <type arch="{{ lab_node_arch }}" machine="{{ lab_node_machine }}">hvm</type>
    <loader readonly="yes" type="pflash">{{ lab_node_firmware_code }}</loader>
    <nvram template="{{ lab_node_firmware_vars }}"/>
    <boot dev="hd"/>
  </os>
{% if lab_node_arch != 'aarch64' %}
  <features>
    <acpi/>
    <apic/>
    <pae/>
  </features>
{% endif %}
  <cpu mode="host-passthrough" check="none"/>
  <clock offset="utc"/>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>
  <devices>
    <emulator>{{ lab_node_emulator }}</emulator>
    <disk type="file" device="disk">
      <driver name="qemu" type="qcow2"/>
      <source file="{{ lab_libvirt_images_dir }}/{{ node.name }}.qcow2"/>
      <target dev="vda" bus="virtio"/>
    </disk>
{% if lab_node_arch == 'aarch64' %}
    <controller type="scsi" index="0" model="virtio-scsi"/>
    <disk type="file" device="cdrom">
      <driver name="qemu" type="raw"/>
      <target dev="sda" bus="scsi"/>
      <readonly/>
    </disk>
{% if lab_node_dual_cd | default(false) | bool %}
    <disk type="file" device="cdrom">
      <driver name="qemu" type="raw"/>
      <target dev="sdb" bus="scsi"/>
      <readonly/>
    </disk>
{% endif %}
{% else %}
    <disk type="file" device="cdrom">
      <driver name="qemu" type="raw"/>
      <target dev="sda" bus="sata"/>
      <readonly/>
    </disk>
{% if lab_node_dual_cd | default(false) | bool %}
    <disk type="file" device="cdrom">
      <driver name="qemu" type="raw"/>
      <target dev="sdb" bus="sata"/>
      <readonly/>
    </disk>
{% endif %}
    <controller type="sata" index="0"/>
{% endif %}
    <interface type="network">
      <mac address="{{ node.mac }}"/>
      <source network="{{ lab_network_name }}"/>
      <model type="virtio"/>
    </interface>
    <serial type="pty">
      <target port="0"/>
    </serial>
    <console type="pty">
      <target type="serial" port="0"/>
    </console>
    <memballoon model="virtio"/>
    <rng model="virtio">
      <backend model="random">/dev/urandom</backend>
    </rng>
{% if lab_node_arch != 'aarch64' %}
    <video>
      <model type="vga" vram="16384" heads="1"/>
    </video>
{% endif %}
  </devices>
</domain>
